apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${app_name}
  labels:
    app: ${app_name}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: ${app_name}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 1
  template:
    metadata:
      labels:
        app: ${app_name}
        version: ${image_tag}
    spec:
      containers:
      - name: ${app_name}
        image: ${acr_server}/${image_repo}:${image_tag}
        env:
        - name: MONGO_URI
          value: ${mongo_uri}
        - name: PORT
          value: "3000"
        ports:
        - containerPort: 3000
      imagePullSecrets:
      - name: acr-auth
